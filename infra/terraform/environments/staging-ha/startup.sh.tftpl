#!/bin/bash
# Boots one app VM: install Docker and Ops Agent, pull images, fetch env from Secret Manager, run compose.
# Boot image là Debian 12 (xem variables.tf boot_image). Ops Agent ghi metric agent.googleapis.com/memory/percent_used
# mà autoscaler đọc; Container-Optimized OS không hỗ trợ Ops Agent nên không dùng được cho MIG này (2026-10-08).
# Chạy compose trong image docker:27-cli (đã kiểm trên VM thật: compose v2.33).
# KHÔNG dùng $-mở-ngoặc-nhọn trong file này (templatefile của Terraform).
set -euo pipefail
export HOME=/var/lib/vota
export DEBIAN_FRONTEND=noninteractive
mkdir -p "$HOME" /etc/vota

apt-get update -qq
apt-get install -y -qq docker.io jq curl iptables python3 ca-certificates
systemctl enable --now docker

# Ops Agent: cài từ repo chính thức. Lần sau khởi động lại VM script chạy lại, bước này idempotent.
if ! systemctl is-active --quiet google-cloud-ops-agent; then
  curl -sSo /tmp/add-ops-agent-repo.sh https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh
  bash /tmp/add-ops-agent-repo.sh --also-install
fi

iptables -A INPUT -p tcp --dport 3000 -j ACCEPT

TOKEN=$(curl -fsS -H 'Metadata-Flavor: Google' http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token | jq -er .access_token)
PROJECT=$(curl -fsS -H 'Metadata-Flavor: Google' http://metadata.google.internal/computeMetadata/v1/project/project-id)
curl -fsS -H "Authorization: Bearer $TOKEN" "https://secretmanager.googleapis.com/v1/projects/$PROJECT/secrets/${backend_env_secret}/versions/latest:access" \
  | jq -er .payload.data | base64 -d > /etc/vota/backend.env
chmod 600 /etc/vota/backend.env

mkdir -p /etc/vota/secrets
chmod 700 /etc/vota/secrets
if grep -q '^JWT_PRIVATE_KEY_B64=' /etc/vota/backend.env; then
  grep '^JWT_PRIVATE_KEY_B64=' /etc/vota/backend.env | cut -d'=' -f2- | tr -d '\r' | base64 -d > /etc/vota/secrets/jwt-private.pem
  grep '^JWT_PUBLIC_KEY_B64=' /etc/vota/backend.env | cut -d'=' -f2- | tr -d '\r' | base64 -d > /etc/vota/secrets/jwt-public.pem
  # The backend image runs as UID/GID 10001 (user `app`), so keep the keys root-owned
  # while allowing that process to traverse the directory and read the bind-mounted files.
  chown root:10001 /etc/vota/secrets /etc/vota/secrets/*.pem
  chmod 750 /etc/vota/secrets
  chmod 640 /etc/vota/secrets/*.pem
fi
# The frontend gets only what it needs, not the DB credentials in backend.env.
{
  grep -E '^AUTH_SERVICE_TOKEN=' /etc/vota/backend.env || true
  sed -n 's/^AUTH_REDIS_URL=/SESSION_REDIS_URL=/p' /etc/vota/backend.env
} > /etc/vota/frontend.env
chmod 600 /etc/vota/frontend.env

# Đăng nhập Artifact Registry bằng access token của service account (thay docker-credential-gcr của COS).
echo "$TOKEN" | docker login -u oauth2accesstoken --password-stdin '${registry_host}'
cat > /etc/vota/pgbouncer.ini.tmpl <<'PGBINI'
${pgbouncer_ini}
PGBINI
cat > /etc/vota/pgbouncer-setup.sh <<'PGBSETUP'
${pgbouncer_setup}
PGBSETUP
chmod +x /etc/vota/pgbouncer-setup.sh
/etc/vota/pgbouncer-setup.sh /etc/vota/backend.env /etc/vota/pgbouncer /etc/vota/pgbouncer.ini.tmpl
cat > /etc/vota/compose.yml <<'COMPOSE'
${compose}
COMPOSE

export BACKEND_IMAGE='${backend_image}' FRONTEND_IMAGE='${frontend_image}' UVICORN_WORKERS='${uvicorn_workers}' \
  UVICORN_GRACEFUL_SECONDS='${graceful_seconds}' BACKEND_STOP_GRACE='${stop_grace_seconds}'
# Image riêng kéo bằng docker của host (đã đăng nhập ở trên); compose trong container dùng ảnh đã có sẵn.
docker pull "$BACKEND_IMAGE"
docker pull "$FRONTEND_IMAGE"
docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v /etc/vota:/etc/vota -w /etc/vota \
  -e BACKEND_IMAGE -e FRONTEND_IMAGE -e UVICORN_WORKERS -e UVICORN_GRACEFUL_SECONDS -e BACKEND_STOP_GRACE \
  docker:27-cli docker compose -f /etc/vota/compose.yml up -d
