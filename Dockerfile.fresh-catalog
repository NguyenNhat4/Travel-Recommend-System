# Fresh catalog crawler: all collectors, Chromium and Xvfb run inside this image.
# Build from the repository root: docker build -f Dockerfile.fresh-catalog -t vota-fresh-catalog:latest .
#
# Index job embed bằng cùng model, cùng revision, cùng torch và transformers như backend (Dockerfile.backend): backend embed
# truy vấn, job này embed tài liệu, lệch thư viện là lệch vector mà không báo lỗi. Trước 2026-10-13 job dùng
# transformers<5 và torch không ghim trong khi backend dùng transformers==5.18.0 và torch==2.14.1.
ARG EMBED_MODEL=intfloat/multilingual-e5-small
ARG EMBED_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3

# Stage model: tải e5-small một lần, không phụ thuộc requirements (đổi requirements không tải lại ~470 MB model).
FROM python:3.15-slim-bookworm AS model
ARG EMBED_MODEL
ARG EMBED_MODEL_REVISION
ENV HF_HOME=/opt/hf
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install "huggingface_hub>=1.31,<3" \
    && python -c "from huggingface_hub import snapshot_download; snapshot_download('${EMBED_MODEL}', revision='${EMBED_MODEL_REVISION}', allow_patterns=['*.json', '*.safetensors', 'sentencepiece.bpe.model'])" \
    && chmod -R a+rX /opt/hf

FROM python:3.15-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/src \
    VOTA_DATA_DIR=/data \
    CATALOG_STATE_DIR=/data/state \
    CATALOG_RUN_ROOT=/data/fresh_runs \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    TZ=Asia/Ho_Chi_Minh

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends xvfb xauth tzdata ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY src/data_collection/requirements.txt /tmp/catalog-requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install -r /tmp/catalog-requirements.txt \
    && python -m playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 app \
    && mkdir -p /data \
    && chmod -R a+rX /ms-playwright \
    && chown app:app /data

# torch bản CPU (bản PyPI kéo CUDA vài GB), ghim đúng bản trong requirements-embed.txt của backend.
COPY src/backend/requirements-embed.txt /tmp/backend-requirements-embed.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --index-url https://download.pytorch.org/whl/cpu \
        "$(grep -E '^torch==' /tmp/backend-requirements-embed.txt)"
COPY src/backend/jobs/requirements.txt /tmp/index-requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip python -m pip install -r /tmp/index-requirements.txt

ARG EMBED_MODEL
ARG EMBED_MODEL_REVISION
ENV HF_HOME=/opt/hf \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1
COPY --from=model /opt/hf /opt/hf
COPY src/backend /app/src/backend
COPY src/data_collection /app/src/data_collection

# Kiểm ngay lúc build: model nạp được offline và embed đúng 384 chiều, cùng đường code với backend.
RUN cd /app && python -c "from src.backend.app.infrastructure.embeddings.local_e5_embedder import LocalE5Embedder; v = LocalE5Embedder('${EMBED_MODEL}', revision='${EMBED_MODEL_REVISION}').embed_query('kiểm tra'); assert v.shape == (384,), v.shape"

WORKDIR /app/src/data_collection
USER app

ENTRYPOINT ["bash", "/app/src/data_collection/run_fresh_catalog_container.sh"]
CMD ["auto"]
