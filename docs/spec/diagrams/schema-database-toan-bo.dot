digraph FullSchema {
graph [rankdir=TB,bgcolor="white",fontname="DejaVu Sans",pad=0.5,nodesep=0.55,ranksep=1.1,splines=polyline,compound=true,newrank=true];
node [fontname="DejaVu Sans",fontsize=12,shape=plain];
edge [fontname="DejaVu Sans",fontsize=10,color="#64748b",arrowsize=0.7];
subgraph cluster_ota_app { label="DB 1: ota_app — 24 bảng · sản phẩm, lịch phòng, tài khoản, đặt chỗ, vector"; labelloc=t; labeljust=l; fontsize=24; fontcolor="#1d4ed8"; color="#1d4ed8"; penwidth=3; style="rounded,filled"; fillcolor="#f8fbff"; margin=28;
ota_app__catalog_keys [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#1d4ed8"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>catalog_keys</B></TD></TR><TR><TD ALIGN="LEFT"><B>Cột</B></TD><TD ALIGN="LEFT"><B>Kiểu</B></TD><TD ALIGN="LEFT"><B>Khóa / null</B></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id">product_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_kind">product_kind</TD><TD ALIGN="LEFT">varchar(24)</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NN UK¹</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_ref">source_ref</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="deleted_at">deleted_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="3"><FONT POINT-SIZE="10" COLOR="#475569">UK¹ (product_id, product_kind). Chính xác 1 subtype</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="3"><FONT POINT-SIZE="10" COLOR="#475569">/ ID; không lưu nội dung sản phẩm.</FONT></TD></TR></TABLE>>];
ota_app__hotel_properties [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#1d4ed8"><TR><TD COLSPAN="3" BGCOLOR="#dbeafe"><B>hotel_properties</B></TD></TR><TR><TD ALIGN="LEFT"><B>Cột</B></TD><TD ALIGN="LEFT"><B>Kiểu</B></TD><TD ALIGN="LEFT"><B>Khóa / null</B></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id">product_id</TD><TD ALIGN="LEFT">uuid</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_kind">product_kind</TD><TD ALIGN="LEFT">varchar(24)</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">FK CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="destination">destination</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="image_url">image_url</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="attributes">attributes</TD><TD ALIGN="LEFT">jsonb</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="address">address</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="property_type">property_type</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="star_rating">star_rating</TD><TD ALIGN="LEFT">numeric</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="latitude">latitude</TD><TD ALIGN="LEFT">numeric</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="longitude">longitude</TD><TD ALIGN="LEFT">numeric</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="amenities">amenities</TD><TD ALIGN="LEFT">text[]</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price">unit_price</TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="currency">currency</TD><TD ALIGN="LEFT">varchar(3)</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VND</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="price_unit">price_unit</TD><TD ALIGN="LEFT">varchar</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UNKNOWN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_available">source_available</TD><TD ALIGN="LEFT">boolean</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_available_from">source_available_from</TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_available_to">source_available_to</TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="3"><FONT POINT-SIZE="10" COLOR="#475569">CHECK product_kind = HOTEL_PROPERTY. 1.494 cơ sở;</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="3"><FONT POINT-SIZE="10" COLOR="#475569">không đặt trực tiếp. Giá card từ room con.</FONT></TD></TR></TABLE>>];
