FT"><FONT COLOR="#475569">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="airlines">airlines</TD><TD ALIGN="LEFT">text[]</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="round_trip_from">round_trip_from</TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="monthly_prices">monthly_prices</TD><TD ALIGN="LEFT">jsonb</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price">unit_price</TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="currency">currency</TD><TD ALIGN="LEFT">varchar(3)</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">VND</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="price_unit">price_unit</TD><TD ALIGN="LEFT">varchar</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">UNKNOWN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_available">source_available</TD><TD ALIGN="LEFT">boolean</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_available_from">source_available_from</TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_available_to">source_available_to</TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="3"><FONT POINT-SIZE="10" COLOR="#475569">CHECK product_kind = FLIGHT_ROUTE. 60 tuyến; không</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="3"><FONT POINT-SIZE="10" COLOR="#475569">phải vé có ngày bay cụ thể.</FONT></TD></TR></TABLE>>];
