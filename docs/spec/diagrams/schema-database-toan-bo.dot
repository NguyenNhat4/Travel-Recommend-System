cdp__events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="white" COLOR="#c2410c"><TR><TD COLSPAN="3" BGCOLOR="#ffedd5"><B>events</B></TD></TR><TR><TD ALIGN="LEFT"><B>Cột</B></TD><TD ALIGN="LEFT"><B>Kiểu</B></TD><TD ALIGN="LEFT"><B>Khóa / null</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id</TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cdp_user_id">cdp_user_id</TD><TD ALIGN="LEFT">varchar(64)</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NN UK¹</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="event_id">event_id</TD><TD ALIGN="LEFT">varchar(128)</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NN UK¹</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="event_name">event_name</TD><TD ALIGN="LEFT">varchar(32)</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="timestamp">timestamp</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id">product_id</TD><TD ALIGN="LEFT">varchar(128)</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL không FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="taxonomy">taxonomy</TD><TD ALIGN="LEFT">varchar(16)</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="event_group_id">event_group_id</TD><TD ALIGN="LEFT">varchar(64)</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price">unit_price</TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL đề xuất</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="using_date">using_date</TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="search_query">search_query</TD><TD ALIGN="LEFT">varchar(500)</TD><TD ALIGN="LEFT"><FONT COLO