FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    HF_HOME=/opt/hf \
    HF_HUB_DISABLE_TELEMETRY=1

WORKDIR /app

RUN useradd --create-home --uid 10001 app \
    && chown -R app:app /app

# torch bản CPU (bản mặc định của PyPI kéo CUDA, nặng vài GB) rồi tải sẵn e5-small đúng revision ghim trong core/config.py:
# runtime không cần mạng tới Hugging Face (HF_HUB_OFFLINE=1).
ARG EMBED_MODEL=intfloat/multilingual-e5-small
ARG EMBED_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
ENV HF_HOME=/opt/hf
RUN python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch>=2.3"
COPY src/backend/requirements.txt /tmp/backend-requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/backend-requirements.txt
RUN python -c "from huggingface_hub import snapshot_download; snapshot_download('${EMBED_MODEL}', revision='${EMBED_MODEL_REVISION}', allow_patterns=['*.json', '*.safetensors', 'sentencepiece.bpe.model'])" \
    && chmod -R a+rX /opt/hf
ENV HF_HUB_OFFLINE=1

# Embedding local (FR-SRC-02): torch bản CPU lấy từ index CPU của PyTorch — bản PyPI trên Linux kéo CUDA (~2 GB thừa).
# Phiên bản đọc từ requirements-embed.txt để chỉ ghim ở một chỗ.
COPY src/backend/requirements-embed.txt /tmp/backend-requirements-embed.txt
RUN python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        "$(grep -E '^torch==' /tmp/backend-requirements-embed.txt)" \
    && python -m pip install --no-cache-dir -r /tmp/backend-requirements-embed.txt

# Tải sẵn model lúc build (đúng revision ghim trong core/config.py; test kiểm hai giá trị trùng nhau) để container không
# tải gì lúc khởi động. Chỉ lấy các file transformers cần — cache ~475 MB. Sau bước này HF chạy offline: đổi
# EMBED_MODEL_REVISION lúc chạy mà không build lại image thì nạp model báo lỗi rõ ràng thay vì tải ngầm.
# Kích thước image: thêm ~0,7 GB torch CPU + transformers và ~0,47 GB model so với image chỉ có Cohere.
ARG EMBED_MODEL=intfloat/multilingual-e5-small
ARG EMBED_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
RUN python -c "from huggingface_hub import snapshot_download; snapshot_download('${EMBED_MODEL}', revision='${EMBED_MODEL_REVISION}', allow_patterns=['config.json', 'model.safetensors', 'tokenizer.json', 'tokenizer_config.json', 'special_tokens_map.json', 'sentencepiece.bpe.model'])" \
    && chmod -R a+rX /opt/hf
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

# The API imports the backend package, OpenAPI bundle and shared itinerary fixtures.
COPY src/backend /app/src/backend
COPY src/shared/contracts /app/src/shared/contracts
COPY src/shared/mocks /app/src/shared/mocks
# Runner migration chạy trong image này lúc deploy (scripts/deploy-backend-vm.sh); chỉ cần thư mục migrations.
COPY db/migrations /app/db/migrations

# Kiểm ngay lúc build: model nạp được offline từ cache và embed thử một câu ra đúng 384 chiều.
RUN python -c "from src.backend.app.infrastructure.embeddings.local_e5_embedder import LocalE5Embedder; LocalE5Embedder('${EMBED_MODEL}', revision='${EMBED_MODEL_REVISION}').warmup()"

USER app

EXPOSE 8000

# Số worker đọc từ UVICORN_WORKERS (mặc định 1); --timeout-graceful-shutdown để SSE đang chạy xong khi VM bị rút khỏi LB.
CMD ["python", "-m", "uvicorn", "src.backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-graceful-shutdown", "30", "--no-access-log"]
