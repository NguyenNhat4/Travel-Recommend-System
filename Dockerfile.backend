# Base ghim theo digest. Tag python:3.11-slim đổi digest khi Docker Hub vá base, và mọi layer phía sau phụ thuộc digest
# đó: build staging-ha lúc 2026-10-09 15:56 mất cache toàn bộ (~7,5 phút) dù Dockerfile và requirements không đổi
# (digest 0dd364… → e88e97…). Dependabot (ecosystem docker) mở PR khi có digest mới; khi đổi, sửa cả hai dòng FROM cùng lúc.
ARG EMBED_MODEL=intfloat/multilingual-e5-small
ARG EMBED_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3

# Stage model: tải e5-small một lần. Stage này không phụ thuộc requirements, nên đổi requirements không tải và đẩy lại
# ~470 MB model. BuildKit chạy stage này song song với bước cài torch.
FROM python:3.11-slim@sha256:e88e9763f943ec1834f992a4b51e0f24500486803e8bc534e5767af9ea65f6ce AS model
ARG EMBED_MODEL
ARG EMBED_MODEL_REVISION
ENV HF_HOME=/opt/hf
# Cùng dải phiên bản huggingface-hub mà transformers 5.18 kéo về.
RUN python -m pip install --no-cache-dir "huggingface_hub>=1.31,<3" \
    && python -c "from huggingface_hub import snapshot_download; snapshot_download('${EMBED_MODEL}', revision='${EMBED_MODEL_REVISION}', allow_patterns=['*.json', '*.safetensors', 'sentencepiece.bpe.model'])" \
    && chmod -R a+rX /opt/hf

FROM python:3.11-slim@sha256:e88e9763f943ec1834f992a4b51e0f24500486803e8bc534e5767af9ea65f6ce
ARG EMBED_MODEL
ARG EMBED_MODEL_REVISION

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    HF_HOME=/opt/hf \
    HF_HUB_DISABLE_TELEMETRY=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

WORKDIR /app

RUN useradd --create-home --uid 10001 app \
    && chown -R app:app /app

# torch bản CPU lấy từ index PyTorch (bản PyPI trên Linux kéo CUDA vài GB). Ghim đúng bản trong requirements-embed.txt
# ngay lần cài đầu: cài "torch>=2.3" trước rồi mới ghim sẽ hạ cấp và tải lại ~200 MB nếu index có bản mới hơn.
# Phải đứng trước requirements.txt để pip không kéo torch CUDA từ PyPI.
COPY src/backend/requirements-embed.txt /tmp/backend-requirements-embed.txt
RUN python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        "$(grep -E '^torch==' /tmp/backend-requirements-embed.txt)"

# Model e5-small từ stage model. Đặt sau torch và trước requirements: đổi requirements không làm layer này build lại.
COPY --from=model /opt/hf /opt/hf

# transformers (ghim 5.18.0) nằm trong requirements.txt: một lần resolve, không cài hai lần như trước.
COPY src/backend/requirements.txt /tmp/backend-requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/backend-requirements.txt

# The API imports the backend package, OpenAPI bundle and shared itinerary fixtures.
COPY src/backend /app/src/backend
COPY src/shared/contracts /app/src/shared/contracts
COPY src/shared/mocks /app/src/shared/mocks
# Runner migration chạy trong image này lúc deploy (scripts/deploy-backend-vm.sh); chỉ cần thư mục migrations.
COPY db/migrations /app/db/migrations

# Kiểm ngay lúc build: model nạp được offline từ cache và embed thử một câu ra đúng 384 chiều.
RUN python -c "from src.backend.app.infrastructure.embeddings.local_e5_embedder import LocalE5Embedder; v = LocalE5Embedder('${EMBED_MODEL}', revision='${EMBED_MODEL_REVISION}').embed_query('kiểm tra'); assert v.shape == (384,), v.shape"

USER app

EXPOSE 8000

# Số worker đọc từ UVICORN_WORKERS (mặc định 1). Thời gian chờ SSE đang chạy khi VM bị rút khỏi LB đọc từ
# UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN (uvicorn tự đọc biến này); nhóm HA đặt 100 giây để phủ SSE 90 giây của trợ lý.
ENV UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=30
CMD ["python", "-m", "uvicorn", "src.backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
