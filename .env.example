# Copy to .env and fill in.  NEVER commit .env (spec section 11).
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env

# --- Postgres ----------------------------------------------------------------
# Một instance (docker-compose.yml), hai database: `vota` và `insider`.
# Login role của dev do db/init/03_roles_dev.sql tạo sẵn. Mật khẩu dưới đây chỉ dùng local.
#
# Backend dùng HAI connection tách biệt, không bao giờ dùng chung một connection:
#   DATABASE_URL     — catalog + app; chỉ SELECT được cdp.products, không thấy cdp.events/profiles
#   CDP_DATABASE_URL — LocalCdpClient, chỉ schema cdp (role cdp_writer)
DATABASE_URL=postgresql://vota_app_login:vota@localhost:5432/vota
CDP_DATABASE_URL=postgresql://cdp_client_login:cdp@localhost:5432/vota
CDP_ADAPTER=local

# Evaluation chỉ đọc cdp.*; loader/seed cần superuser (ghi cdp.*, catalog.*, app.* và tạo extension).
EVAL_DATABASE_URL=postgresql://cdp_eval_login:eval@localhost:5432/vota
SEED_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vota

# Insider clone là service riêng: chỉ src/insider_clone và seed_insider chạm database này.
# Backend gọi Insider qua HTTP, không có connection nào tới database `insider`.
INSIDER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insider
INSIDER_BASE_URL=http://localhost:8081
INSIDER_TOKEN=dev-token

# Các URL trên là DSN thuần cho psycopg v3 (`psycopg.connect`). Nếu một service dùng SQLAlchemy
# thì phải ghi rõ driver — `postgresql+psycopg://` — vì `postgresql://` trần khiến SQLAlchemy
# đi tìm psycopg2, thứ không phải dependency của project này.

# --- crawl politeness (spec section 8) ---------------------------------------
# These mirror config.yaml. Precedence rule (see config.py): env overrides
# config.yaml for everything EXCEPT rate limit and concurrency, where env may
# only LOWER the value, never raise it — spec section 8 makes config.yaml the
# authority for the <= 0.5 rps / <= 2 concurrency ceiling.
RATE_LIMIT_RPS=0.5
MAX_CONCURRENCY=2

# Honest identity + a real contact address, per spec section 11. Must NOT
# contain "Mozilla" — tests/test_invariants.py asserts that, because a browser
# UA on a crawler is anti-bot evasion, which spec section 1 forbids.
USER_AGENT=VOTA-RecSys-Internship/0.1 (+mailto:you@example.com)

# --- Amadeus Self-Service API (spec section 9 fallback) ----------------------
# Free test tier. Register at https://developers.amadeus.com/register, create a
# "Self-Service" app, then copy the API Key / API Secret here. The test tier is
# rate limited and its data is a static test set, which is fine for Week 1.
# Leave blank to keep the amadeus collector disabled.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# --- runtime -----------------------------------------------------------------
# Required on Windows. Without it, Python's default encoding here is cp1252 and
# any Vietnamese output crashes with UnicodeEncodeError the moment stdout is
# piped or redirected (`python -m cli report > report.txt`).
PYTHONUTF8=1
