# Copy this file to .env and fill in local values. Never commit .env.

# --- LLM cho itinerary agent -------------------------------------------------
# Composition root dựng MỘT client dùng chung lúc khởi động (main.py lifespan).
# ITINERARY_USE_LLM=false: không dựng client nào, app vẫn khởi động được không cần API key,
# /assistant/status báo llmMode=disabled và request itinerary trả 503 LLM_UNAVAILABLE.
ITINERARY_USE_LLM=true
# Provider chọn theo key nào được đặt, thứ tự: Gemini -> OpenAI -> Anthropic.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Model của agent (biến duy nhất); bỏ trống thì mỗi provider dùng mặc định: gpt-4o-mini,
# gemini-2.5-flash, claude-sonnet-4-20250514.
ITINERARY_LLM_MODEL=
# Orchestrator là luồng duy nhất của trợ lý (chốt 13/10/2026); model riêng của nó, các bước khác giữ ITINERARY_LLM_MODEL.
ITINERARY_ORCHESTRATOR_MODEL=gpt-6.1-sol
ITINERARY_ORCHESTRATOR_PROVIDER=openai
ITINERARY_ORCHESTRATOR_REASONING_EFFORT=low
# Agent chỉ gọi structured output/tool calling nên cần quyết định ổn định.
ITINERARY_LLM_TEMPERATURE=0
# Chỉ OpenAI. Model reasoning (vd gpt-6-luna) báo 400 khi dùng function tools mà reasoning còn bật:
# đặt none. Bỏ trống = không gửi tham số. Giá trị: none|minimal|low|medium|high.
ITINERARY_LLM_REASONING_EFFORT=

# --- LangSmith tracing (tuỳ chọn, tắt mặc định) ------------------------------
# Bật là quyết định chủ ý: composition root chỉ đẩy 4 biến này vào os.environ khi
# LANGSMITH_TRACING=true VÀ có LANGSMITH_API_KEY (main.py:_forward_langsmith_env). Prompt và dữ
# liệu người dùng sẽ được gửi lên LANGSMITH_ENDPOINT khi bật — chỉ bật ở môi trường dev cá nhân.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=Travel-agent

# --- Itinerary agent ---------------------------------------------------------
# Nguồn dữ liệu cho tool của agent: fixture (mock 50 sản phẩm) | inprocess (gọi engine Search/Recommendation
# trong cùng tiến trình, cần RecSys đã nạp) | http (gọi ITINERARY_SERVICE_BASE_URL) | disabled.
# Để trống: fixture ở development/test, disabled ở production.
ITINERARY_DATA_MODE=fixture
# Chỉ dùng khi ITINERARY_DATA_MODE=http.
ITINERARY_SERVICE_BASE_URL=
# Ngân sách thời gian của spec §7.2: LLM 2s, tool 1s, toàn request dưới 5s. Giá trị dưới đây
# nới rộng cho việc gỡ lỗi local; siết lại về mức của spec trước khi đo hiệu năng.
ITINERARY_TOOL_TIMEOUT_SECONDS=1
ITINERARY_LLM_TIMEOUT_SECONDS=30
ITINERARY_REQUEST_TIMEOUT_SECONDS=90
ITINERARY_CONVERSATION_TTL_SECONDS=86400
# Working memory của agent; dùng DB index riêng với auth/session. Trống chỉ được ở dev/test.
ITINERARY_REDIS_URL=redis://:devpass@localhost:6379/2
ASSISTANT_API_BASE_URL=http://127.0.0.1:8000/api/v1

# FastAPI settings.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Search / Recommendation -------------------------------------------------
# Model theo PRD FR-SRC-02 (chốt 06/10/2026): chỉ e5-small, chạy local trong backend/job index (không cần khoá), 384 chiều,
# collection ProductE5Small (VECTOR_COLLECTION; WEAVIATE_COLLECTION cũ không còn được đọc). Model/revision/chiều có mặc định trong core/config.py; thường không cần đặt.
# EMBED_MODEL=intfloat/multilingual-e5-small
# EMBED_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
# EMBED_DIMENSION=384
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
VECTOR_COLLECTION=ProductE5Small
# 0,84 hiệu chỉnh cho e5-small trên gold_v4.
SEARCH_CUTOFF=0.84
# Hybrid /search (BM25 + dense, RRF; từ 25/09). SEARCH_HYBRID=false lùi về dense-only ANN_CANDIDATE_SCORE.
# Các tham số khác (SEARCH_RRF_K, SEARCH_LEXICAL_CANDIDATE_K, SEARCH_LEXICAL_MIN_COVERAGE, SEARCH_BM25_K1/B) có mặc định trong core/config.py.
SEARCH_HYBRID=true
SEARCH_LEXICAL_K=10
SEARCH_LEXICAL_CUTOFF=0.50
# Chuẩn hoá truy vấn trước khi embed/BM25 (viết tắt KS/NT/PQ…, chính tả tên riêng, điểm đến, kiểu đi). false → nguyên câu.
SEARCH_NORMALIZE=true
# FR-SRC-03 (05/10): lọc cứng theo địa danh suy ra từ câu (một địa danh; bỏ khi câu nêu ≥ 2 nơi hoặc hỏi vé máy bay); F rỗng →
# chạy lại không lọc (FR-SRC-04). Mặc định tắt cho tới khi bench xác nhận (contract 1.14.0 diagnostics.destinationFilter, appliedFilters).
# SEARCH_DEST_FILTER=true        # mặc định production 06/10: F1, F2 relax, F3, F5, F6 bật; F4 tắt
# SEARCH_DEST_FILTER_FALLBACK=true
# Câu gõ không dấu: relax = nới cổng vớt BM25 (lexical_k 20, lexical_cutoff 0, phủ tên 0.4) và tuỳ chọn cutoff riêng cho câu
# ≥ 3 token không dấu; off = như cũ. Giá trị nới là tạm, chưa qua dev/test (contract 1.14.0 diagnostics.queryProfile).
# SEARCH_NO_DIACRITICS_MODE=relax
# SEARCH_NO_DIACRITICS_LEXICAL_K=20
# SEARCH_NO_DIACRITICS_LEXICAL_CUTOFF=0.0
# SEARCH_NO_DIACRITICS_MIN_COVERAGE=0.4
# SEARCH_NO_DIACRITICS_CUTOFF=0.80   # đặt ở khối Embedding phía trên; để trống = dùng SEARCH_CUTOFF
# SEARCH_NO_DIACRITICS_MIN_TOKENS=3
# Query plan (kiến trúc Phase A, 05/10; contract 1.15.0 diagnostics.queryPlan): hard constraint suy từ câu, mỗi họ một cờ, mặc định
# tắt cho tới khi gold v4 xác nhận — tắt vẫn parse và khai. Tham số request tường minh (origin, priceMin/Max, starRatingMin,
# availableOnly) luôn được áp theo contract. F rỗng do filter suy ra → trả rỗng + queryPlan.emptyReason, không nới.
# SEARCH_NEGATION_FILTER=true    # "không có / không ghi nhận X" → loại unit có ghi nhận tiện ích X
# SEARCH_TAXONOMY_FILTER=false   # câu nêu đúng một loại sản phẩm → lọc taxonomy (đổi số đếm tab của Web khi bật)
# SEARCH_ROUTE_FILTER=true       # câu vé máy bay "từ A đến B" → lọc originCity / destinationCity
# SEARCH_NUMERIC_FILTER=true     # giá hard ("dưới 2 triệu"), sao soft ("4 sao") suy từ câu
# 06/10 (contract 1.16.0): mặc định tắt / trung tính — giữ nguyên mặc định cho đúng kết quả 1.15.0 tới khi bench gold v4 xác nhận.
# travelContext.guests của POST /search luôn thành filter sức chứa (tham số request), không phụ thuộc cờ nào dưới đây.
# SEARCH_TONE_NORMALIZE=false        # dời dấu thanh của câu về kiểu đa số của catalog (hoà ↔ hòa) trước embed/BM25
# SEARCH_TAXONOMY_STRONG_ONLY=false  # F4 chỉ lọc taxonomy khi cue loại mạnh ("khách sạn"); cue yếu ("phòng") chỉ khai
# SEARCH_PARTY_FILTER=false          # số khách suy từ câu ("3 người") → loại unit có sức chứa đã biết nhỏ hơn
# SEARCH_FUZZY_K=0                   # kênh fuzzy tên gần đúng (chỉ hybrid); 0 = tắt, bật thì vớt unit có rank fuzzy ≤ K
# SEARCH_FUZZY_CANDIDATE_K=50        # số ứng viên kênh fuzzy đem fuse
# SEARCH_FUZZY_MIN_SIM=0.75          # độ giống trigram tối thiểu để vớt (0.6 vớt cả tên chung chung)
# SEARCH_RRF_DENSE_WEIGHT=1.0        # trọng số RRF theo nhánh; 1.0 = RRF thường, chỉ tune trên split dev
# SEARCH_RRF_LEXICAL_WEIGHT=1.0
# SEARCH_RRF_FUZZY_WEIGHT=1.0
# LLM fallback của query plan /search (contract 1.17.0): off | shadow | on. Cần OPENAI_API_KEY (hoặc key của provider theo model).
# SEARCH_LLM_FALLBACK=off
# SEARCH_LLM_FALLBACK_MIN_CONFIDENCE=0.75
# SEARCH_LLM_FALLBACK_TIMEOUT_MS=1500
# SEARCH_LLM_FALLBACK_MODEL=gpt-4o-mini
# SEARCH_LLM_FALLBACK_CACHE_SIZE=10000
# SEARCH_LLM_FALLBACK_CACHE_PATH=
# SEARCH_LLM_FALLBACK_CACHE_ONLY=false
# 07/10 (contract 1.18.0): ba họ query plan mới, mặc định tắt — tắt thì KHÔNG parse, không khai (response y như 1.17.0).
# Bật ở production chỉ sau bench WIN/TIE + Forbidden@10 = 0 (docs/plan/2026-10-07-search-duration-entity-poi.md).
# SEARCH_DURATION_FILTER=false       # "3 ngày 2 đêm" / "3N2Đ" → queryPlan.duration; bỏ cụm khỏi câu BM25 (không lọc)
# SEARCH_POI_RESOLVE=false           # địa danh gazetteer trong repo ("Hồ Hoàn Kiếm" → Hà Nội) vào lọc điểm đến; hard.destinationSource = poi
# SEARCH_ENTITY_FILTER=false         # câu nêu điểm vui chơi (VinWonders, Safari, Grand World…) → chỉ attraction/combo có tên chứa
#                                    # entity (gate cứng); đổi số đếm tab của Web khi bật — cần Web xác nhận (như F4)
# SEARCH_LOG_QUERIES=false           # ghi app.search_logs mỗi lượt /search trang đầu (nền, có trần; lỗi không tới response)
# Cache vector truy vấn (contract 1.12.0 diagnostics.embedCache, NFR-PERF-03) và nạp sẵn lúc khởi động; mặc định trong core/config.py.
# SEARCH_EMBED_CACHE=true
# SEARCH_EMBED_CACHE_SIZE=10000
# SEARCH_PREWARM=true
# SEARCH_PREWARM_FILE=data/search_prewarm_queries.txt
# SEARCH_PREWARM_HEAD_QUERIES=200
# SEARCH_PREWARM_INPUTS_PER_MINUTE=2000

# Local service defaults. DATABASE_URL / CDP_DATABASE_URL nằm ở khối Postgres bên dưới —
# KHÔNG khai lại ở đây: khóa trùng thì pydantic-settings lấy dòng cuối, nên một dòng
# DATABASE_URL=sqlite... sót lại sẽ âm thầm vô hiệu hóa toàn bộ cấu hình Postgres.
CDP_BASE_URL=http://localhost:8100
CDP_SERVICE_TOKEN=
# Copy to .env and fill in.  NEVER commit .env (spec section 11).
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env

# --- Postgres ----------------------------------------------------------------
# Một instance (docker-compose.yml), hai database: `vota` và `insider`.
# Login role của dev do db/init/03_roles_dev.sql tạo sẵn. Mật khẩu dưới đây chỉ dùng local.
#
# Backend dùng HAI connection tách biệt, không bao giờ dùng chung một connection:
#   DATABASE_URL     — catalog + app; chỉ SELECT được cdp.products, không thấy cdp.events/profiles
#   CDP_DATABASE_URL — LocalCdpClient, chỉ schema cdp (role cdp_writer)
#
# Máy đã có Postgres khác giữ cổng 5432 thì chạy compose với cổng khác VÀ sửa cả bốn DSN dưới cho khớp:
#   POSTGRES_HOST_PORT=5433 docker compose up -d --wait postgres
#   make db-migrate POSTGRES_HOST_PORT=5433
# Để nguyên 5432 trong khi Postgres của repo chạy ở cổng khác là nối nhầm sang database của project kia.
DATABASE_URL=postgresql://vota_app_login:vota@localhost:5432/vota
CDP_DATABASE_URL=postgresql://cdp_client_login:cdp@localhost:5432/vota
CDP_ADAPTER=local
# Thời hạn kết nối PostgreSQL: DB không với tới được trong khoảng này thì API trả 503 DATABASE_UNAVAILABLE.
# DB_CONNECT_TIMEOUT_SECONDS=3
# DB_TCP_USER_TIMEOUT_MS=15000

# DB replica (staging, tuỳ chọn): bản sao CHỈ ĐỌC của primary, streaming bất đồng bộ nên có thể trễ vài giây.
# Để trống/không đặt = mọi truy vấn đi qua primary (DATABASE_URL, CDP_DATABASE_URL) như cũ.
# Replica là bản sao của cả cụm nên dùng CÙNG user và mật khẩu với primary; chỉ khác host và cổng.
# Trên VM app, replica đi qua tunnel thứ hai (primary 15432, replica 15433):
#   127.0.0.1:15433 -> 10.148.0.4:5432
# Chỉ dành cho đường đọc thuần (catalog, tra cứu sản phẩm, log tìm kiếm, đọc lịch sử CDP).
# KHÔNG dùng cho đăng nhập/token, giỏ hàng, đặt chỗ, thanh toán, ghi CDP: ghi sẽ lỗi
# `cannot execute ... in a read-only transaction`, còn đọc-sau-ghi có thể thấy dữ liệu cũ.
# REPLICA_DATABASE_URL=postgresql://vota_app_login:vota@localhost:15433/vota
# REPLICA_CDP_DATABASE_URL=postgresql://cdp_client_login:cdp@localhost:15433/vota

# Evaluation chỉ đọc cdp.*; loader/seed cần superuser (ghi cdp.*, catalog.*, app.* và tạo extension).
EVAL_DATABASE_URL=postgresql://cdp_eval_login:eval@localhost:5432/vota
SEED_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vota

# --- Auth: hybrid session (docs/hop-dong-tich-hop-auth.md §19) ----------------
# Trình duyệt KHÔNG BAO GIỜ giữ token. BFF (Next.js) giữ cookie phiên + token trong Redis;
# FastAPI là nơi duy nhất có khóa ký. Sinh khóa dev:
#   mkdir -p secrets
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out secrets/jwt-private.pem
#   openssl rsa -pubout -in secrets/jwt-private.pem -out secrets/jwt-public.pem
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ISSUER=https://api.vota.local
JWT_AUDIENCE=vota-api
JWT_ACCESS_TTL_SECONDS=600
JWT_CLOCK_SKEW_SECONDS=60

REFRESH_TTL_SECONDS=43200
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=43200

# OWASP 2024. Không hạ memory cost để chạy nhanh hơn.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Trống = rate limiter trong bộ nhớ (chỉ development/test); production bắt buộc Redis.
AUTH_REDIS_URL=redis://:devpass@localhost:6379/1
# Chỉ tin X-Forwarded-For từ các proxy này; tin vô điều kiện = rate limit bỏ qua được bằng một header.
TRUSTED_PROXIES=127.0.0.1/32

# P0 chỉ có noop; nhà cung cấp CAPTCHA thật và SMTP là P1 — ngoài phạm vi (PRD 2026-09-23).
CAPTCHA_PROVIDER=noop
CAPTCHA_SECRET=

SMTP_URL=
MAIL_FROM=no-reply@vota.local

INTERNAL_API_ENABLED=false
# >= 32 ký tự. BFF và FastAPI phải trùng giá trị. Không đưa vào code frontend, URL hay log.
# Trống = mọi /auth/session* và /internal/* trả 401, web không đăng nhập được. Sinh: openssl rand -hex 32
AUTH_SERVICE_TOKEN=

# --- Auth: BFF (src/frontend) -------------------------------------------------
BACKEND_BASE_URL=http://127.0.0.1:8000
SESSION_REDIS_URL=redis://:devpass@localhost:6379/1
SESSION_COOKIE_NAME=vota_sid
CSRF_COOKIE_NAME=vota_csrf
ALLOWED_ORIGINS=http://localhost:3000

# --- Thanh toán Stripe, test mode (docs/prd/deployment-plan.md §2) -------------
# Chỉ Backend giữ khoá. Khoá sk_live_ bị từ chối khi khởi động: dự án chỉ chạy Stripe test mode.
# Local: `stripe listen --forward-to localhost:8000/api/v1/payments/stripe/webhook` in ra whsec_… cho mỗi máy.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# stripe | fake (offline, không gọi mạng; trang thanh toán giả không mở được trên trình duyệt)
PAYMENT_PROVIDER=stripe
BOOKING_HOLD_MINUTES=30
# Đơn nháp của Đặt ngay sống bao lâu (phút); giỏ và đơn nháp của khách chưa đăng nhập giữ bao lâu trong Redis (ngày).
BOOKING_DRAFT_TTL_MINUTES=30
GUEST_BOOKING_TTL_DAYS=3
# Redis cho giỏ và đơn nháp của khách chưa đăng nhập, DB index riêng. Trống: lưu trong bộ nhớ tiến trình (chỉ dev/test,
# mất khi khởi động lại); production bắt buộc có.
BOOKING_REDIS_URL=redis://:devpass@localhost:6379/3
PAYMENT_MAX_FAILED_ATTEMPTS=3
# Gốc URL web để dựng success_url/cancel_url của phiên Stripe
PUBLIC_WEB_URL=http://localhost:3000

# --- Tài khoản test ------------------------------------------------------------
# 4 persona + 50 user test do seed_histories.py tạo, mật khẩu demo chung `Demo@2026`,
# băm sẵn Argon2id ngay lúc seed (src/data_collection/seed/config.py DEMO_PASSWORD).
# Không cần biến môi trường riêng.

# --- OAuth (P2, chưa dùng) ----------------------------------------------------
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:3000/auth/callback

# --- Vector: e5-small + Weaviate (docs/prd/architecture.md §5, deployment-plan.md §2) ----
# Job `make index-vectors` đọc search unit qua DATABASE_URL, embed bằng e5-small local, ghi VECTOR_COLLECTION.
# Weaviate không tự vector hoá (vectorizer: none), không nhận khoá nào.
# Dev dùng Weaviate local (deployment-plan.md §1): http://localhost:8080 (docker compose up -d --wait weaviate),
# bỏ trống API key. Collection trên Weaviate Cloud do job cào trên VM ghi — một collection chỉ đi với
# một Postgres: đừng trỏ .env dev vào Cloud rồi chạy `make index-vectors`, vì job xoá mọi vector không có trong DB
# của máy chạy. `make backend` (compose) luôn dùng Weaviate local; môi trường dùng cluster chung thì đặt
# BACKEND_WEAVIATE_URL và BACKEND_WEAVIATE_API_KEY cho container backend.
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
# RecSys truy vấn top-K qua gRPC. Local: cổng 50051 của docker compose; Weaviate Cloud tự dùng 443.
WEAVIATE_GRPC_PORT=50051
# Chỉ dùng khi job index tạo collection mới: local hnsw; Weaviate Cloud của nhóm chỉ cho phép hfresh.
# Collection đã có thì giữ nguyên loại index (job chỉ cảnh báo nếu khác).
WEAVIATE_VECTOR_INDEX_TYPE=hnsw
# Backend nạp lại giá, trạng thái và cửa sổ ngày từ Postgres mỗi N giây; lỗi thì giữ bản đang phục vụ.
CATALOG_REFRESH_SECONDS=900
# /recommendations gửi các lượt Weaviate độc lập song song trên pool riêng (output y hệt tuần tự); 0 = tuần tự.
# RECOMMEND_IO_WORKERS=16
# Nạp sẵn vector theo id vào RAM ở nền sau mỗi lần nạp catalog (khoảng 6 MB mỗi tiến trình); ANN vẫn qua Weaviate.
# RECOMMEND_PRELOAD_VECTORS=true
# Cache kết quả gợi ý trên Redis dùng chung, DB index riêng (dev dùng 1, 2, 3 cho auth, trợ lý, giỏ khách). Khoá chứa dấu
# vân tay lịch sử event nên event mới luôn tính lại; mọi khoá có TTL. Trống: tắt cache, mỗi request tính lại.
RECOMMEND_CACHE_REDIS_URL=redis://:devpass@localhost:6379/4
# RECOMMEND_CACHE_TTL_SECONDS=900

# Insider clone là service riêng: chỉ src/insider_clone và seed_insider chạm database này.
# Backend gọi Insider qua HTTP, không có connection nào tới database `insider`.
INSIDER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insider
INSIDER_BASE_URL=http://localhost:8081
INSIDER_TOKEN=dev-token

# Các URL trên là DSN thuần cho psycopg v3 (`psycopg.connect`). Nếu một service dùng SQLAlchemy
# thì phải ghi rõ driver — `postgresql+psycopg://` — vì `postgresql://` trần khiến SQLAlchemy
# đi tìm psycopg2, thứ không phải dependency của project này.

# --- crawl politeness (spec section 8) ---------------------------------------
# These mirror config.yaml. Precedence rule (see config.py): env overrides
# config.yaml for everything EXCEPT rate limit and concurrency, where env may
# only LOWER the value, never raise it — spec section 8 makes config.yaml the
# authority for the <= 0.5 rps / <= 2 concurrency ceiling.
RATE_LIMIT_RPS=0.5
MAX_CONCURRENCY=2

# Honest identity + a real contact address, per spec section 11. Must NOT
# contain "Mozilla" — tests/test_invariants.py asserts that, because a browser
# UA on a crawler is anti-bot evasion, which spec section 1 forbids.
USER_AGENT=VOTA-RecSys-Internship/0.1 (+mailto:you@example.com)

# --- Amadeus Self-Service API (spec section 9 fallback) ----------------------
# Free test tier. Register at https://developers.amadeus.com/register, create a
# "Self-Service" app, then copy the API Key / API Secret here. The test tier is
# rate limited and its data is a static test set, which is fine for Week 1.
# Leave blank to keep the amadeus collector disabled.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# --- runtime -----------------------------------------------------------------
# Required on Windows. Without it, Python's default encoding here is cp1252 and
# any Vietnamese output crashes with UnicodeEncodeError the moment stdout is
# piped or redirected (`python -m cli report > report.txt`).
PYTHONUTF8=1

# --- search bench (src/evaluation/search_bench) -------------------------------
# Cohere embed-multilingual-v3.0 — chỉ bench so sánh (src/evaluation), backend không dùng. Giá trị thật chỉ nằm trong .env, không commit.
# sbench chỉ nạp các khoá COHERE_API_KEY / AWS_PROFILE / LLM_PROVIDER / SBENCH_* từ .env
# và không ghi đè biến môi trường thật; giá trị rỗng bị bỏ qua.
COHERE_API_KEY=
# Ghi đè tuỳ chọn:
# SBENCH_HOME=
# SBENCH_WEAVIATE_HTTP_PORT=58080
# SBENCH_WEAVIATE_GRPC_PORT=55051
# Đo /search thật qua HTTP và parity Cloud vs local (spec bench Part 9, `sb latency http`, `sb parity`):
# SBENCH_CLOUD_BASE_URL=https://v-ota.duckdns.org
# SBENCH_LOCAL_BASE_URL=http://127.0.0.1:8000
# SBENCH_CLOUD_WEAVIATE_URL=            # Weaviate Cloud của production (đọc vector cho `sb parity --mode weaviate`)
# SBENCH_CLOUD_WEAVIATE_API_KEY=
# SBENCH_VM_DATABASE_URL=               # DSN Postgres VM qua tunnel SSH (127.0.0.1:15432) — chỉ đặt trong shell, không ghi file

# Mật khẩu nhóm của app soát draft gold (Streamlit) đặt trong .streamlit/secrets.toml
# ([labeling] app_password = "…") hoặc Streamlit Community Cloud → Settings → Secrets,
# không đặt ở đây. Fallback biến môi trường: LABELING_APP_PASSWORD.
