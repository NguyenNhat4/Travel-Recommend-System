# Copy this file to .env and fill in local values. Never commit .env.

# Optional LLM support for Streamlit fixture mode and FastAPI.
OPENAI_API_KEY=
ITINERARY_USE_LLM=false
ITINERARY_LLM_MODEL=gpt-4o-mini

# FastAPI settings.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
MODEL_NAME=gpt-4o-mini

# Local service defaults.
DATABASE_URL=sqlite:///./data/app.db
CDP_BASE_URL=http://localhost:8100
CDP_SERVICE_TOKEN=
