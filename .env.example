# Copy to .env and fill in.  NEVER commit .env (spec section 11).
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env

# --- Postgres ----------------------------------------------------------------
POSTGRES_DB=vota
POSTGRES_USER=vota
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_HOST=localhost
# Host port for the compose service. 5432 is frequently already taken by
# another project's Postgres; pick a free one and keep DATABASE_URL in step.
# Inside the compose network the port is always 5432.
POSTGRES_PORT=5433

# Full DSN. Must use the psycopg (v3) driver explicitly — a bare
# `postgresql://` URL makes SQLAlchemy look for psycopg2, which is not a
# dependency of this project.
DATABASE_URL=postgresql+psycopg://vota:change-me-before-first-run@localhost:5433/vota

# --- crawl politeness (spec section 8) ---------------------------------------
# These mirror config.yaml. Precedence rule (see config.py): env overrides
# config.yaml for everything EXCEPT rate limit and concurrency, where env may
# only LOWER the value, never raise it — spec section 8 makes config.yaml the
# authority for the <= 0.5 rps / <= 2 concurrency ceiling.
RATE_LIMIT_RPS=0.5
MAX_CONCURRENCY=2

# Honest identity + a real contact address, per spec section 11. Must NOT
# contain "Mozilla" — tests/test_invariants.py asserts that, because a browser
# UA on a crawler is anti-bot evasion, which spec section 1 forbids.
USER_AGENT=VOTA-RecSys-Internship/0.1 (+mailto:you@example.com)

# --- Amadeus Self-Service API (spec section 9 fallback) ----------------------
# Free test tier. Register at https://developers.amadeus.com/register, create a
# "Self-Service" app, then copy the API Key / API Secret here. The test tier is
# rate limited and its data is a static test set, which is fine for Week 1.
# Leave blank to keep the amadeus collector disabled.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# --- runtime -----------------------------------------------------------------
# Required on Windows. Without it, Python's default encoding here is cp1252 and
# any Vietnamese output crashes with UnicodeEncodeError the moment stdout is
# piped or redirected (`python -m cli report > report.txt`).
PYTHONUTF8=1
# Copy this file to .env and fill in local values. Never commit .env.

# Optional LLM support for Streamlit fixture mode and FastAPI.
OPENAI_API_KEY=
ITINERARY_USE_LLM=false
ITINERARY_LLM_MODEL=gpt-4o-mini
ITINERARY_DATA_MODE=fixture
ITINERARY_SERVICE_BASE_URL=
ITINERARY_TOOL_TIMEOUT_SECONDS=1
ITINERARY_LLM_TIMEOUT_SECONDS=30
ITINERARY_REQUEST_TIMEOUT_SECONDS=90
ITINERARY_CONVERSATION_TTL_SECONDS=86400
ASSISTANT_API_BASE_URL=http://127.0.0.1:8000/api/v1

# FastAPI settings.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
MODEL_NAME=gpt-4o-mini

# Local service defaults.
DATABASE_URL=sqlite:///./data/app.db
CDP_BASE_URL=http://localhost:8100
CDP_SERVICE_TOKEN=
