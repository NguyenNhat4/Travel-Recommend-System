# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Next server-only proxy target. Point to the FastAPI backend.
BACKEND_BASE_URL="http://127.0.0.1:8000"

# --- Auth BFF (docs/spec/hop-dong-tich-hop-auth.md §4, §19) — chỉ phía server, không có tiền tố NEXT_PUBLIC_.
# Trùng giá trị AUTH_SERVICE_TOKEN của backend (>= 32 ký tự). Không bao giờ đưa vào code client.
AUTH_SERVICE_TOKEN=""
# Trống = session store trong bộ nhớ (chỉ dev); production bắt buộc Redis.
SESSION_REDIS_URL="redis://:devpass@localhost:6379/1"
SESSION_COOKIE_NAME="vota_sid"
CSRF_COOKIE_NAME="vota_csrf"
ALLOWED_ORIGINS="http://localhost:3000"
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=43200
