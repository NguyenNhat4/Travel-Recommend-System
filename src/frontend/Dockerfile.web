FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY src/frontend/package.json src/frontend/package-lock.json ./src/frontend/
WORKDIR /app/src/frontend
RUN npm ci

FROM deps AS builder
WORKDIR /app
COPY src/frontend ./src/frontend
COPY src/shared/mocks ./src/shared/mocks
WORKDIR /app/src/frontend
RUN npm run build:web

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000
COPY --from=builder /app/src/frontend/.next/standalone ./
COPY --from=builder /app/src/frontend/.next/static ./.next/static
EXPOSE 3000
CMD ["node", "server.js"]
