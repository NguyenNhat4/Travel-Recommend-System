FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY src/frontend/package.json src/frontend/package-lock.json ./src/frontend/
WORKDIR /app/src/frontend
# Cache npm nằm trong builder BuildKit cố định của runner, không vào image.
RUN --mount=type=cache,target=/root/.npm npm ci

FROM deps AS builder
WORKDIR /app
COPY src/frontend ./src/frontend
COPY src/shared/mocks ./src/shared/mocks
COPY src/shared/contracts/tests ./src/shared/contracts/tests
WORKDIR /app/src/frontend
# .next/cache (cache biên dịch của Next) giữ giữa các lần build; image chỉ lấy standalone và static.
RUN --mount=type=cache,target=/app/src/frontend/.next/cache npm run build:web

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000
COPY --from=builder /app/src/frontend/.next/standalone ./
COPY --from=builder /app/src/frontend/.next/static ./.next/static
EXPOSE 3000
CMD ["node", "server.js"]
