{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "next dev -p 3000",
    "dev:api": "cross-env PORT=3001 tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "next build --webpack && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "build:api": "esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-api/server.cjs",
    "start": "npm run start:web",
    "start:web": "node .next/standalone/server.js",
    "start:api": "node dist-api/server.cjs",
    "clean": "rm -rf .next dist dist-api",
    "generate:api-types": "openapi-typescript ../shared/contracts/openapi.yaml -o src/types/api.gen.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:api": "vitest run tests/api tests/contract",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "npm run build:web && playwright test"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "next": "^16.3.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^5.0.1"
  }
}
