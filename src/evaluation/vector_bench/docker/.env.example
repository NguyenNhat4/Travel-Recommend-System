# Chép thành docker/.env (bị gitignore). `vb doctor` tự tạo docker/.env và điền VBENCH_HOME nếu thiếu.
# `vb` ghi đè ENGINE_CPUS / ENGINE_MEM theo run.profile (hoặc fast.engine_limits khi chạy `vb fast`),
# và PG_* theo fast.pg_env khi chạy `vb fast`.

VBENCH_HOME=<đường dẫn tuyệt đối tới <repo>/bench_out, dùng dấu />

# image tag
PGVECTOR_IMAGE=pgvector/pgvector:0.8.6-pg16
PGVS_IMAGE=timescale/timescaledb-ha:pg16.15-ts2.30.1
QDRANT_TAG=v1.19.1
# chưa dùng ở fast-track (Part 8b–8d)
WEAVIATE_TAG=<<TỰ ĐIỀN 1.37.x>>
OPENSEARCH_TAG=<<TỰ ĐIỀN 3.x>>
MILVUS_TAG=v3.0.1

# port (lệch khỏi app: 5432 là DB vota)
PGVECTOR_PORT=55432
PGVS_PORT=55433
QDRANT_HTTP_PORT=56333
QDRANT_GRPC_PORT=56334

# giới hạn tài nguyên engine
ENGINE_CPUS=4
ENGINE_MEM=8g

# Postgres (profile full gợi ý: PG_SHARED_BUFFERS=4GB, PG_MAINT_MEM=4GB, PG_PAR_MAINT=4)
PG_SHARED_BUFFERS=2GB
PG_MAINT_MEM=1GB
PG_PAR_MAINT=2
PG_SHM_SIZE=2g
