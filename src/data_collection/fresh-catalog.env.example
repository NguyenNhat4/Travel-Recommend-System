# Copy to /etc/vota/fresh-catalog.env on the crawler VM; owner = deploy user, mode 600.
# Docker --env-file: KEY=value, no shell quotes or variable interpolation.
# Replace CHANGE_ME values on the VM. Never commit the completed secret file.
# Existing DB VM is reached through the app VM's SSH tunnel (host network).
DB_TARGET=cloud
CLOUD_SEED_DATABASE_URL=postgresql://LOADER_USER:URL_ENCODED_PASSWORD@127.0.0.1:15432/vota
# Optional read-only connection for indexing; blank uses CLOUD_SEED_DATABASE_URL.
CLOUD_DATABASE_URL=
COHERE_API_KEY=CHANGE_ME
# Index: lô Cohere gọi cùng lúc và trần lượt gọi mỗi phút. Key Trial: 4 / 90; key Production: vd. 8 / 1500.
COHERE_EMBED_CONCURRENCY=4
COHERE_CALLS_PER_MINUTE=90
CLOUD_WEAVIATE_URL=https://CHANGE_ME.weaviate.cloud
CLOUD_WEAVIATE_API_KEY=CHANGE_ME
WEAVIATE_VECTOR_INDEX_TYPE=hfresh

# Saved monitor settings override these values. Defaults favor more hotels per run.
CATALOG_DESTINATIONS=@deep
TRIP_INITIAL_PER_CITY=30
TRIP_NEW_PER_CITY=10
TRIP_DAILY_HOTELS=180
TRIP_DISCOVERY_SCAN_PER_CITY=300
FAST_WORKERS=4
PRICE_WORKERS=2
MIN_DELAY=0.5
MAX_DELAY=1.0
FULL_REFRESH_DAYS=7
CRAWL_PARALLEL=2
