# Copy to /etc/vota/fresh-catalog.env on the crawler VM; owner = deploy user, mode 600.
# Docker --env-file: KEY=value, no shell quotes or variable interpolation.
# Replace CHANGE_ME values on the VM. Never commit the completed secret file.
# DB: tên riêng db.vota.internal (private DNS, cổng 5432 trực tiếp, KHÔNG qua pgbouncer: khoá DB của job là advisory lock
# mức session). Tên này theo leader khi failover (ILB Patroni) hoặc ops/promote-db-replica.sh, nên job không còn phụ thuộc
# một IP cố định hay đường hầm SSH (docs/plan/2026-10-07-ha-vung-crawler-rolling.md §4). Máy chạy job phải ở VPC có zone
# vota.internal; gắn network tag vota-crawler để firewall cho phép tới 5432.
DB_TARGET=cloud
CLOUD_SEED_DATABASE_URL=postgresql://LOADER_USER:URL_ENCODED_PASSWORD@db.vota.internal:5432/vota
# Khoá một-lượt-chạy ở mức DB (mặc định bật). Chỉ tắt (off) khi chạy thử không có Postgres thật.
CATALOG_DB_RUN_LOCK=on
# CATALOG_LOCK_DIR: đặt khoá tệp ra thư mục khác state (mặc định nằm trong state).
# Optional read-only connection for indexing; blank uses CLOUD_SEED_DATABASE_URL.
CLOUD_DATABASE_URL=
# Bước index embed bằng e5-small có sẵn trong image (PRD FR-SRC-02): không cần khoá Cohere.
CLOUD_WEAVIATE_URL=https://CHANGE_ME.weaviate.cloud
CLOUD_WEAVIATE_API_KEY=CHANGE_ME
WEAVIATE_VECTOR_INDEX_TYPE=hfresh

# Saved monitor settings override these values. Defaults favor more hotels per run.
CATALOG_DESTINATIONS=@deep
TRIP_INITIAL_PER_CITY=30
TRIP_NEW_PER_CITY=10
TRIP_DAILY_HOTELS=180
TRIP_DISCOVERY_SCAN_PER_CITY=300
FAST_WORKERS=4
PRICE_WORKERS=2
MIN_DELAY=0.5
MAX_DELAY=1.0
FULL_REFRESH_DAYS=7
CRAWL_PARALLEL=2
