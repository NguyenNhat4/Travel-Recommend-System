# Sao chép thành .env (đã nằm trong .gitignore). KHÔNG commit, KHÔNG dán vào chat hay tài liệu.
# Mỗi dịch vụ chỉ một tài khoản (điều khoản Apify §4.3 cấm nhiều tài khoản cá nhân).
# Apify: https://console.apify.com → Settings → API & Integrations → Personal API token (gói Free: $5/tháng, không cần thẻ)
APIFY_TOKEN=
# SerpApi (Google Hotels): https://serpapi.com/manage-api-key (250 lượt tìm kiếm free/tháng)
SERPAPI_KEY=
# Travelpayouts (giá vé Aviasales): API token trong hồ sơ Travelpayouts (miễn phí)
TRAVELPAYOUTS_TOKEN=
# Mật khẩu Postgres local của `docker-compose.yml` ở repository root.
DEMO_DB_PASSWORD=postgres

# ---- Job hằng ngày (daily.py / cron_daily.sh / run_daily_docker.sh) -----------------------------------------------
# Chạy bằng Docker trên VPS (run_daily_docker.sh): chép khối này thành ENV_FILE (mặc định /etc/vota/daily.env, chmod 600),
# đặt DAILY_LOAD=cloud. Image không có .env ở gốc repository nên COHERE_API_KEY đặt ngay ở file này. Không bọc giá trị
# trong nháy: docker --env-file giữ nguyên dấu nháy.
# Đích nạp sau mỗi lần promote catalog, cách nhau dấu phẩy: local, cloud (để trống = chỉ cập nhật file, không nạp DB).
DAILY_LOAD=
# Đích local dùng SEED_DATABASE_URL, DATABASE_URL, WEAVIATE_URL, WEAVIATE_API_KEY, COHERE_API_KEY của .env ở gốc
# repository (backend dùng chung). Đặt lại ở file này nếu muốn job dùng giá trị khác.
# Cloud (staging): VPS cùng mạng nội bộ (VPC) với VM Postgres thì trỏ thẳng IP nội bộ, dạng
# postgresql://<user>:<mật khẩu đã mã hoá URL>@<IP nội bộ VM DB>:5432/vota; máy ngoài VPC đi qua SSH tunnel tới 127.0.0.1:15432.
# User cần INSERT/UPDATE cdp.products và DELETE/INSERT catalog.combo_items. Mật khẩu có ký tự đặc biệt thì mã hoá URL
# (vd. python -c "import urllib.parse;print(urllib.parse.quote('<mật khẩu>', safe=''))"). Để trống thì không nạp cloud.
CLOUD_SEED_DATABASE_URL=
# Job embed đọc catalog bằng kết nối này; để trống thì dùng CLOUD_SEED_DATABASE_URL.
# Job cào mới (`run_daily_docker.sh fresh-run`, DB_TARGET=cloud) dùng cùng các biến CLOUD_* này cho bước index.
CLOUD_DATABASE_URL=
# Dạng: https://<cluster>.weaviate.cloud
CLOUD_WEAVIATE_URL=
CLOUD_WEAVIATE_API_KEY=
# Vé Thương gia mô phỏng cho demo (docs/prd/data-model.md §3): mặc định bật (để trống) — sau mỗi lần nạp catalog sinh vé
# Thương gia "(giá minh hoạ)" (giá vé gốc × 2,65) cho mọi vé có số hiệu chuyến. 0 = tắt, khoá các vé mô phỏng đã có.
SIMULATED_BUSINESS_FARES=
# Chỉ dùng khi phải tạo lại collection: Weaviate Cloud của nhóm chỉ cho phép hfresh.
WEAVIATE_VECTOR_INDEX_TYPE=hfresh
# Key Cohere cho bước embed. Chạy ngoài Docker thì để trống: dòng trống không che giá trị ở .env gốc.
COHERE_API_KEY=
# Agoda trong job hằng ngày: số khách sạn tối đa mỗi điểm đến, số giờ tối đa mỗi ngày (tự dừng êm, lượt sau làm tiếp).
DAILY_AGODA_PER_CITY=50
DAILY_AGODA_HOURS=14

# ---- Job mới (fresh-run / fresh-monitor): cùng env và volume trên VM ---------------------------------------
# Giá trị lưu trên monitor ưu tiên hơn env. Không chạy cron daily.py cùng đích DB.
DB_TARGET=cloud
TRIP_INITIAL_PER_CITY=30
TRIP_NEW_PER_CITY=10
TRIP_DAILY_HOTELS=180
TRIP_DISCOVERY_SCAN_PER_CITY=300
FAST_WORKERS=4
PRICE_WORKERS=2
MIN_DELAY=0.5
MAX_DELAY=1.0
FULL_REFRESH_DAYS=7
CRAWL_PARALLEL=2
