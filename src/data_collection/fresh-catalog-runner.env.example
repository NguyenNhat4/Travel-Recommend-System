# Copy to /etc/vota/fresh-catalog-runner.env. No secrets in this file.
# Replace the image with a published immutable tag or digest, and docker pull it first.
# This file is read by the host shell/systemd, not Docker --env-file.
FRESH_IMAGE=REGION-docker.pkg.dev/PROJECT/REPOSITORY/vota-fresh-catalog:TAG
FRESH_DATA_DIR=/srv/vota/fresh-catalog-data
CATALOG_ENV_FILE=/etc/vota/fresh-catalog.env
CATALOG_LOG_DIR=/srv/vota/fresh-catalog-logs
FRESH_CONTAINER_NAME=vota-fresh-catalog
FRESH_NETWORK=host
FRESH_SHM_SIZE=512m
# Giới hạn RAM của job cào (mặc định 2500m khi không đặt; để rỗng = không giới hạn)
FRESH_MEMORY=2500m
PULL=0
