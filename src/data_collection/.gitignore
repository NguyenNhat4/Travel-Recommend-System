# Dữ liệu sinh ra khi chạy, không đưa vào git: catalog 12 MB, HTML/JSON thô 42 MB,
# và browser-profile chứa cookie phiên đăng nhập.
data/
cache/*
!cache/.gitkeep
# Catalog: bản crawl thật và bản tổng hợp do seed/gen_products.py sinh lại được từ (--seed, --as-of).
products.jsonl
products.synthetic.jsonl
.venv/
__pycache__/
*.pyc
