# Mẫu cho `make tunnel`. Chép thành .env.tunnel (đã gitignore) rồi điền.
# Giá trị đọc nguyên văn sau dấu '=': không quote, không để chú thích cùng dòng.

# Tài khoản Google của chính bạn (đã được cấp quyền IAP và OS Login trên project vinpearl-508801).
# Ví dụ: IAP_SSH_USER=ten_ban_gmail_com   (dạng OS Login: email với '@' và '.' thay bằng '_')
IAP_SSH_USER=
# Khóa SSH của tài khoản trên. Để trống thì dùng ~/.ssh/google_compute_engine.
IAP_SSH_KEY=
